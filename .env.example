# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ─── Firebase Cloud Messaging (web push) ─────────────────────────────────────
# Only needed for browser notifications. Leave unset and web push simply does
# not appear — the switch in الإعدادات hides itself rather than failing.
# All five are PUBLIC values (Firebase Console → Project settings → General →
# Your apps → Web app). The credential that can actually SEND is the service
# account, and it lives only in the send-push edge function's secrets.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# Cloud Messaging → Web Push certificates → "Key pair"
VITE_FIREBASE_VAPID_KEY=""
