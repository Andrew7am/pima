# Android native project (generated by `npx cap add android`) — the
# project itself IS committed (manifest/gradle config isn't fully
# regenerable), but build output, local SDK paths, and signing
# credentials are per-machine/secret and must never be committed.
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/captures/
android/*.iml
android/.idea/
*.keystore
*.jks
# Signing credentials. The keystore itself is covered above; these hold the
# passwords that open it, so they must never be committed either.
keystore.properties
signing.properties
.vercel
supabase/apply-all.sql

# Test artifacts
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# Database backups — a full dump of production, including every user row.
# Never in git.
backups/
