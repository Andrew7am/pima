<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or transferred: every record lives server-side, and the
     WebView storage holds the sign-in session, which must not follow to a new device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
