# Android release signing — TEMPLATE. Copy to `android/keystore.properties`
# and fill in real values. That file is gitignored and must never be committed.
#
#   cp android/keystore.properties.example android/keystore.properties
#
# Generate the upload keystore first (see the command in the B1 report). Use a
# long, unique password — if this key is lost AND you are not enrolled in Play
# App Signing, the app can never be updated again.
#
# storeFile is resolved relative to the `android/` directory.

storeFile=pima-upload.jks
storePassword=CHANGE_ME
keyAlias=pima-upload
keyPassword=CHANGE_ME

# CI alternative — set these environment variables instead of this file:
#   PIMA_KEYSTORE_FILE
#   PIMA_KEYSTORE_PASSWORD
#   PIMA_KEY_ALIAS
#   PIMA_KEY_PASSWORD
